# ---------------------------------------------------------------------------
# NetNova Notify - sample environment file
# Copy to .env and replace every placeholder. Never commit a real .env file.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Must be a long random value (>= 32 chars) in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL connection string. The API, worker and migrations share this value.
DATABASE_URL=postgresql+psycopg://netnova:netnova@localhost:5432/netnova

# Sessions
SESSION_TTL_HOURS=12
# Set to true on HTTPS deployments.
COOKIE_SECURE=false

# Comma separated origins allowed to call the API directly.
# In the standard deployment the Next.js server proxies /api/v1, so this is only
# needed for direct browser access to the API during development.
CORS_ORIGINS=http://localhost:3000

# Central Telegram bot. Leave TELEGRAM_BOT_TOKEN empty to run in mock mode
# (messages are simulated and clearly marked as mock in the UI).
TELEGRAM_BOT_TOKEN=
# Telegram sends this value in X-Telegram-Bot-Api-Secret-Token on webhook calls.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# auto | http | mock
TELEGRAM_ADAPTER=auto
# Optional: receive a short alert when an employer requests activation or a
# project ticket gets a new employer message.
ADMIN_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Additional delivery channels. Each provider is configured once for the whole
# agency; per-project enablement happens in the admin panel. Leave the token/key
# empty to keep the channel disabled: the panel reports it as "not configured"
# and projects cannot turn it on.
# ---------------------------------------------------------------------------

# Bale messenger bot (Beta). Bot tokens are created in the Bale bot builder.
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai

# Eitaa bot API (Beta).
EITAA_BOT_TOKEN=
EITAA_API_BASE=https://eitaa.com/api

# sms.ir panel (Beta). The line number is the sending line registered there.
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

# Timeout for outgoing provider HTTP calls (seconds).
CHANNEL_HTTP_TIMEOUT_SECONDS=10

# One-time bootstrap of the first admin (only used when no admin exists).
BOOTSTRAP_ADMIN_EMAIL=admin@netnova.ir
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=مدیر نت نووا

# Worker
# Drain the queue inside the API process. Required on hosts without a worker
# plan (Render free); leave false when you run `python -m app.worker.main`.
EMBEDDED_WORKER=false
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=10
WORKER_STALE_SECONDS=300
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=30

# Notification / payment policy
TEHRAN_TIMEZONE=Asia/Tehran
PAYMENT_REMINDER_DAYS_BEFORE=3

# Rate limits (per minute)
LOGIN_RATE_LIMIT=10
ACTIVATION_RATE_LIMIT=10

# Frontend (server-side only, used by Next.js rewrites)
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional public site URL used in deployment docs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development-only: regex for extra trusted browser origins (for example a hosted
# preview URL). Ignored unless ENVIRONMENT=development. Leave empty in production.
DEV_PREVIEW_ORIGIN_REGEX=
