# Caddy terminates TLS automatically (Let's Encrypt) for the configured domain.
# Enable it with the "production" compose profile.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API and Telegram webhook go straight to FastAPI.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health/* {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js admin panel.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
